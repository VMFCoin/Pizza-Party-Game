generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StakingPosition {
  id        String   @id @default(cuid())
  fid       Int      @unique
  wallet    String
  stakedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wallet])
}

// Cached staker data from blockchain for fast leaderboard loading
model Staker {
  id             String   @id @default(cuid())
  wallet         String   @unique
  totalStaked    String   // BigInt stored as string
  flexibleAmount String
  lockedAmount   String
  tier           Int
  // Farcaster profile data (cached)
  fid            Int?
  username       String?
  displayName    String?
  pfpUrl         String?
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([totalStaked])
}

// Track free slice sends for anti-abuse detection
model SliceSend {
  id              String   @id @default(cuid())
  // Sender info
  senderAddress   String
  senderFid       Int
  senderUsername  String?
  // Recipient info
  recipientAddress String
  recipientFid    Int
  recipientUsername String?
  // Game info
  dailyGameId     BigInt
  // Metadata for behavioral detection
  ipHash          String?  // Hashed IP for privacy
  userAgent       String?
  // Claim tracking
  claimed         Boolean  @default(false)
  claimedAt       DateTime?
  claimerIpHash   String?  // Compare with sender IP
  // Flags
  flagged         Boolean  @default(false)
  flagReason      String?
  // Timestamps
  createdAt       DateTime @default(now())

  @@unique([senderAddress, recipientAddress, dailyGameId])
  @@index([senderFid])
  @@index([recipientFid])
  @@index([senderAddress])
  @@index([recipientAddress])
  @@index([flagged])
}
