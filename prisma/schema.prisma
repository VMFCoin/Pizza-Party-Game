generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StakingPosition {
  id        String   @id @default(cuid())
  fid       Int      @unique
  wallet    String
  stakedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wallet])
}
