generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StakingPosition {
  id        String   @id @default(cuid())
  fid       Int      @unique
  wallet    String
  stakedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wallet])
}

// Cached staker data from blockchain for fast leaderboard loading
model Staker {
  id             String   @id @default(cuid())
  wallet         String   @unique
  totalStaked    String   // BigInt stored as string
  flexibleAmount String
  lockedAmount   String
  tier           Int
  // Farcaster profile data (cached)
  fid            Int?
  username       String?
  displayName    String?
  pfpUrl         String?
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([totalStaked])
}

// Persistent lifetime claimed totals for parlor owners
model ParlorLifetimeClaimed {
  id              String   @id @default(cuid())
  wallet          String   @unique // owner wallet address (lowercase)
  totalClaimed    String   // BigInt stored as string (wei)
  lastClaimTxHash String?  // most recent claim tx hash
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@index([wallet])
}

// Track free slice sends for anti-abuse detection
model SliceSend {
  id              String   @id @default(cuid())
  // Sender info
  senderAddress   String
  senderFid       Int
  senderUsername  String?
  // Recipient info
  recipientAddress String
  recipientFid    Int
  recipientUsername String?
  // Game info
  dailyGameId     BigInt
  // Metadata for behavioral detection
  ipHash          String?  // Hashed IP for privacy
  userAgent       String?
  // Claim tracking
  claimed         Boolean  @default(false)
  claimedAt       DateTime?
  claimerIpHash   String?  // Compare with sender IP
  // Flags
  flagged         Boolean  @default(false)
  flagReason      String?
  // Timestamps
  createdAt       DateTime @default(now())

  @@unique([senderAddress, recipientAddress, dailyGameId])
  @@index([senderFid])
  @@index([recipientFid])
  @@index([senderAddress])
  @@index([recipientAddress])
  @@index([flagged])
}

// QR Sticker finds - geotagged sticker discoveries around the world
model StickerFind {
  id            String   @id @default(cuid())
  // Location data
  latitude      Float
  longitude     Float
  city          String?
  address       String?
  businessName  String?
  country       String?
  // Image
  imageUrl      String   // Pinata IPFS URL
  // Finder info (anonymous allowed)
  finderAddress String?  // Wallet address if connected
  finderFid     Int?     // Farcaster FID if available
  finderName    String?  // Display name
  // On-chain recording
  txHash        String?  // Base tx hash if recorded on-chain
  // Timestamps
  createdAt     DateTime @default(now())

  @@index([finderAddress])
  @@index([finderFid])
  @@index([city])
  @@index([country])
  @@index([createdAt])
}

// Tipping vault: every Farcaster cast that triggered a tip (sent or attempted)
// Used for fast pre-flight dedup before hitting on-chain `usedCastHashes`,
// and as an audit trail for monitoring / forensics.
model TipCast {
  id                String   @id @default(cuid())
  castHash          String   @unique // 0x... bytes32 — globally unique
  // Sender (the tipper)
  fromWallet        String
  fromFid           Int
  fromUsername      String?
  // Recipient
  toWallet          String
  toFid             Int      // MUST be > 0 (contract enforces, API double-checks)
  toUsername        String?
  // Amount in wei (PIZZA, 18 decimals)
  amount            String   // BigInt as string
  // Status: pending | sent | failed | rejected
  status            String   @default("pending")
  errorReason       String?  // Why it failed/got rejected
  txHash            String?  // On-chain tx hash if sent
  // Cast metadata
  castTimestamp     DateTime // When the cast was created on Farcaster
  parentCastHash    String?  // The cast being replied to
  // Timestamps
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([fromFid])
  @@index([toFid])
  @@index([fromWallet])
  @@index([status])
  @@index([createdAt])
}

// Indexed chat messages from PizzaChat contract events
model ChatMessage {
  id              String   @id @default(cuid())
  roomId          Int      @default(0)
  messageId       Int      // On-chain message ID within room
  senderAddress   String   // Wallet address
  senderFid       Int?     // Farcaster FID (resolved by indexer)
  senderName      String?  // Display name from Farcaster
  senderPfp       String?  // Profile picture URL
  message         String   @db.VarChar(250)
  pizzaFeePaid    String   // BigInt as string (wei)
  replyToHash     String?  // bytes32 hex of replied message
  onchainTs       DateTime // Block timestamp
  txHash          String?  // Transaction hash
  blockNumber     BigInt?  // Block number for cursor
  hidden          Boolean  @default(false) // Frontend moderation
  createdAt       DateTime @default(now())

  @@unique([roomId, messageId])
  @@index([roomId, onchainTs])
  @@index([senderAddress])
  @@index([blockNumber])
}
