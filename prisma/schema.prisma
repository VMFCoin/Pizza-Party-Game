generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StakingPosition {
  id        String   @id @default(cuid())
  fid       Int      @unique
  wallet    String
  stakedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wallet])
}

// Cached staker data from blockchain for fast leaderboard loading
model Staker {
  id             String   @id @default(cuid())
  wallet         String   @unique
  totalStaked    String   // BigInt stored as string
  flexibleAmount String
  lockedAmount   String
  tier           Int
  // Farcaster profile data (cached)
  fid            Int?
  username       String?
  displayName    String?
  pfpUrl         String?
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([totalStaked])
}
