# =============================================================================
# SETTLE BOT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your values

# Contract address for the game contract
GAME_CONTRACT_ADDRESS=0x...

# RPC URL for the blockchain (use a private RPC, not public endpoints)
# Examples:
#   Base Mainnet: https://base-mainnet.g.alchemy.com/v2/YOUR_KEY
#   Base Sepolia: https://base-sepolia.g.alchemy.com/v2/YOUR_KEY
#   Ethereum:     https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
RPC_URL=https://...

# Private key for the bot wallet (DO NOT COMMIT THIS!)
# Bot wallet address: 0xBfCA21E41D397C8B6beF0c348D394DA2c4826292
# Fund this wallet with enough ETH for gas (~0.01 ETH should be plenty)
PRIVATE_KEY=0x...
